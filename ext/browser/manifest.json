{
  "manifest_version": 3,
  "name": "OpenDM 下载接管",
  "version": "1.0.0",
  "description": "把浏览器的下载交给本地运行的 OpenDM —— 多线程分段、断点续传、自定义 Cookie。",
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenDM",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html"
}
