<Window x:Class="OpenDM.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="600" Height="726" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="26,0,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="设置" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="&#xE711;" Style="{StaticResource IconBtn}" Width="30" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>

                    <!-- ================= 网络与任务 ================= -->
                    <TextBlock Text="网络与任务" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="默认保存目录" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Style="{StaticResource Input}"/>
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource ToolBtn}"
                                Margin="8,0,0,0" MinHeight="40" Padding="12,0" Click="Browse_Click"/>
                    </Grid>

                    <TextBlock Text="默认并发连接数（1–64）" Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="ConnSlider" Width="420" Minimum="1" Maximum="64"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Value, ElementName=ConnSlider, StringFormat={}{0:F0}}"
                                   FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                   MinWidth="24"/>
                    </StackPanel>

                    <TextBlock Text="同时下载任务数（1–16），多出的自动排队" Style="{StaticResource FieldLabel}"
                               Margin="0,16,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="QueueSlider" Width="420" Minimum="1" Maximum="16"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Value, ElementName=QueueSlider, StringFormat={}{0:F0}}"
                                   FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"
                                   MinWidth="24"/>
                    </StackPanel>

                    <!-- ================= 限速与代理 ================= -->
                    <TextBlock Text="限速与代理" Style="{StaticResource SectionTitle}" Margin="0,20,0,10"/>

                    <TextBlock Text="全局限速（KB/s），0 = 不限速；1024 = 1 MB/s，对所有任务合计生效"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SpeedBox" Style="{StaticResource Input}" Width="150"
                             HorizontalAlignment="Left" HorizontalContentAlignment="Left"/>

                    <TextBlock Text="代理" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <TextBox x:Name="ProxyBox" Style="{StaticResource Input}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="留空 = 跟随系统；none = 直连；也可填 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080（支持 user:pass@）"/>

                    <!-- ================= 浏览器接管 ================= -->
                    <TextBlock Text="浏览器接管" Style="{StaticResource SectionTitle}" Margin="0,20,0,10"/>

                    <CheckBox x:Name="BridgeCheck" Style="{StaticResource Check}"
                              Content="开启本地接管接口（浏览器点击下载即交给 OpenDM）"
                              Checked="BridgeCheck_Changed" Unchecked="BridgeCheck_Changed"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="端口" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox x:Name="PortBox" Grid.Column="1" Style="{StaticResource Input}"/>

                        <TextBlock Grid.Column="2" Text="令牌" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="18,0,10,0"/>
                        <TextBox x:Name="TokenBox" Grid.Column="3" Style="{StaticResource Input}"
                                 IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI"/>
                        <Button Grid.Column="4" Content="复制" Style="{StaticResource ToolBtn}"
                                Margin="8,0,0,0" MinHeight="40" Padding="12,0" Click="CopyToken_Click"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="扩展的选项页里填这两个值。令牌防止任意网页往你队列塞文件，别外传。"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource ToolBtn}" Width="88" MinHeight="40"
                        Click="Close_Click" IsCancel="True"/>
                <Button Content="保存" Style="{StaticResource PrimaryBtn}" Width="96" MinHeight="40"
                        Margin="10,0,0,0" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
