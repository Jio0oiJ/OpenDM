<Window x:Class="OpenDM.App.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="属性" Width="580" SizeToContent="Height" MaxHeight="660"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,0,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="属性" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="&#xE711;" Style="{StaticResource IconBtn}" Width="30" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <!-- 文件名单独一行，长名字也不挤掉右侧按钮 -->
            <TextBlock x:Name="TitleText" Grid.Row="1" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,12"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

            <ScrollViewer Grid.Row="2" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Rows"/>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Button Content="复制全部信息" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left"
                        Click="CopyAll_Click"/>
                <Button Content="关闭" Style="{StaticResource PrimaryBtn}" Width="96" MinHeight="38"
                        HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" IsCancel="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
