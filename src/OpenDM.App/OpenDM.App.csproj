<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenDM</AssemblyName>
    <RootNamespace>OpenDM.App</RootNamespace>
    <Product>OpenDM</Product>
    <AssemblyTitle>OpenDM 开源下载管理器</AssemblyTitle>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\opendm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenDM.Core\OpenDM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\opendm.ico" />
  </ItemGroup>

</Project>
