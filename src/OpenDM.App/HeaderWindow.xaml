<Window x:Class="OpenDM.App.HeaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请求头" Width="620" Height="404" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,0,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="Cookie / 请求头" FontSize="14.5" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="&#xE711;" Style="{StaticResource IconBtn}" Width="30" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,6">
                <TextBlock x:Name="FileNameText" Style="{StaticResource Muted}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" Margin="0,0,120,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="导入文件…" Style="{StaticResource LinkBtn}" Click="Import_Click"/>
                    <Button Content="清空" Style="{StaticResource LinkBtn}" Margin="14,0,0,0"
                            Click="Clear_Click"/>
                </StackPanel>
            </Grid>

            <TextBox x:Name="HeaderBox" Grid.Row="2" Style="{StaticResource Input}" Height="176"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                     TextChanged="HeaderBox_TextChanged"/>

            <StackPanel Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Top">
                <TextBlock x:Name="HintText" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="改动在下次「开始 / 继续」时生效；不能修改 Host、Range 等由引擎控制的头。"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="取消" Style="{StaticResource ToolBtn}" Width="88" MinHeight="40"
                        Click="Close_Click" IsCancel="True"/>
                <Button Content="保存" Style="{StaticResource PrimaryBtn}" Width="96" MinHeight="40"
                        Margin="10,0,0,0" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
