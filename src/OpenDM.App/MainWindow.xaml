<Window x:Class="OpenDM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:OpenDM.Core.Models;assembly=OpenDM.Core"
        xmlns:local="clr-namespace:OpenDM.App"
        Title="OpenDM" Height="740" Width="1140" MinHeight="580" MinWidth="940"
        Icon="/OpenDM;component/Assets/opendm.ico"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12.5"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:StateBrushConverter x:Key="StateBrush"/>
        <local:StateGlyphConverter x:Key="StateGlyph"/>
        <local:PercentConverter x:Key="Percent"/>
        <local:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisible"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 左侧分类项 -->
        <Style x:Key="FilterItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="7" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 任务行 -->
        <Style x:Key="TaskItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="2,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 任务行内容 -->
        <DataTemplate DataType="{x:Type core:DownloadTask}">
            <Grid Height="66">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                        Margin="14,0,12,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                    <Setter Property="Background" Value="#16281B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding State, Converter={StaticResource StateGlyph}}"
                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding FileName}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                   Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="·" Style="{StaticResource Muted}" Margin="7,0"/>
                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Width="164" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid>
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource SlimBar}" Margin="0,7,0,0"/>
                </StackPanel>

                <!-- 下载完成后显示「打开所在文件夹」 -->
                <Button Grid.Column="3" Click="RowOpenFolder_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        ToolTip="打开所在文件夹">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowActionBtn}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="15" Height="15" Stretch="Uniform"
                          Data="M3 6.5C3 5.12 4.12 4 5.5 4H9.6c.53 0 1.04.21 1.41.59L12.4 6H18.5C19.88 6 21 7.12 21 8.5v9c0 1.38-1.12 2.5-2.5 2.5h-13C4.12 20 3 18.88 3 17.5v-11z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 与 exe 图标同源的自绘 logo：渐变圆角块 + 白色下箭头 + 落地托盘 -->
                    <Border Width="28" Height="28" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#93C2FF" Offset="0"/>
                                <GradientStop Color="#4C8DFF" Offset="0.46"/>
                                <GradientStop Color="#1C448C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Width="17" Height="17" Stretch="Uniform">
                            <Canvas Width="16" Height="16">
                                <Path Data="M6.2,2.1 L9.8,2.1 L9.8,7.2 L12.7,7.2 L8,12.1 L3.3,7.2 L6.2,7.2 Z"
                                      Fill="#FFFFFF"/>
                                <Rectangle Canvas.Left="3" Canvas.Top="13.1" Width="10" Height="2"
                                           RadiusX="1" RadiusY="1" Fill="#FFFFFF"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="OpenDM" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BgBrush}" CornerRadius="4" Padding="6,2"
                            Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="开源" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnNew" Style="{StaticResource PrimaryBtn}" Click="BtnNew_Click"
                            ToolTip="新建下载任务（Ctrl+N）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="新建下载" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnResume" Content="&#xE768;" Style="{StaticResource IconBtn}" Click="BtnResume_Click"
                            Margin="8,0,0,0" ToolTip="开始 / 继续"/>
                    <Button x:Name="BtnPause" Content="&#xE769;" Style="{StaticResource IconBtn}" Click="BtnPause_Click"
                            Margin="4,0,0,0" ToolTip="暂停"/>
                    <Button x:Name="BtnFolder" Content="&#xE838;" Style="{StaticResource IconBtn}" Click="BtnFolder_Click"
                            Margin="4,0,0,0" ToolTip="打开所在文件夹（定位到文件）"/>
                    <Button x:Name="BtnRemove" Content="&#xE74D;" Style="{StaticResource IconBtn}" Click="BtnRemove_Click"
                            Margin="4,0,0,0" ToolTip="删除任务（Delete）"/>
                    <Button x:Name="BtnHeaders" Content="请求头" Style="{StaticResource ToolBtn}" Click="BtnHeaders_Click"
                            Margin="4,0,0,0" MinHeight="32" Padding="10,0" FontSize="11.5"
                            ToolTip="为所选任务设置 Cookie / 请求头（Cookie 过期时改这里再续传）"/>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,8"/>
                    <Button x:Name="BtnSettings" Content="&#xE713;" Style="{StaticResource IconBtn}" Click="BtnSettings_Click"
                            ToolTip="设置"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧分类 -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="分类" Style="{StaticResource Muted}" Margin="10,0,0,8"/>

                    <ListBox x:Name="FilterList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource FilterItemStyle}"
                             SelectionChanged="FilterList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Count}" FontSize="11.5" Opacity="0.65"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="{StaticResource BgBrush}" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="当前总速度" Style="{StaticResource Muted}" FontSize="10.5"/>
                            <TextBlock x:Name="TotalSpeedText" Text="—" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,3,0,0"/>
                            <TextBlock x:Name="TotalCountText" Text="0 个任务" Style="{StaticResource Muted}"
                                       FontSize="10.5" Margin="0,3,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 任务列表 + 详情 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ListBox x:Name="TaskList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource TaskItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TaskList_SelectionChanged"
                             MouseDoubleClick="TaskList_MouseDoubleClick"
                             KeyDown="TaskList_KeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Items.Count, ElementName=TaskList, Converter={StaticResource ZeroToVisible}}">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                   Foreground="#2A3542" HorizontalAlignment="Center"/>
                        <TextBlock Text="还没有下载任务" FontSize="14" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="点击右上角「新建下载」，或直接把下载链接拖进窗口"
                                   Style="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 详情面板 -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Visibility="{Binding SelectedItem, ElementName=TaskList, Converter={StaticResource NullToCollapsed}}">
                    <Border.DataContext>
                        <Binding Path="SelectedItem" ElementName="TaskList"/>
                    </Border.DataContext>

                    <Grid Margin="18,14,18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,330,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="DetailOpenFile_Click" Margin="0,0,7,0"
                                        ToolTip="用系统默认程序打开已下载的文件">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MiniBtn}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Data="M13 3H5C4.45 3 4 3.45 4 4v16c0 .55.45 1 1 1h14c.55 0 1-.45 1-1V9l-6-6zM13 4.5L18.5 10H13V4.5z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Text="打开文件" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="DetailOpenFolder_Click" Margin="0,0,12,0"
                                        ToolTip="在资源管理器中打开所在文件夹并选中文件">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MiniBtn}"/>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Data="M3 6.5C3 5.12 4.12 4 5.5 4H9.6c.53 0 1.04.21 1.41.59L12.4 6H18.5C19.88 6 21 7.12 21 8.5v9c0 1.38-1.12 2.5-2.5 2.5h-13C4.12 20 3 18.88 3 17.5v-11z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock Text="打开文件夹" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                           Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Progress, Converter={StaticResource Percent}}"
                                           FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource SlimBar}"
                                     Margin="0,10,0,0"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,11,0,0">
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="·" Style="{StaticResource Muted}" Margin="8,0"/>
                            <TextBlock Text="{Binding SegText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="·" Style="{StaticResource Muted}" Margin="8,0"/>
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="·" Style="{StaticResource Muted}" Margin="8,0"
                                       Visibility="{Binding HasHeaders, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding HeaderSummary}" Style="{StaticResource Muted}"
                                       Visibility="{Binding HasHeaders, Converter={StaticResource BoolToVis}}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="·" Style="{StaticResource Muted}" Margin="8,0"/>
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="3" ItemsSource="{Binding Segments}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                                                 Style="{StaticResource SegBar}" Margin="0,0,2,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource Muted}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,280,0"/>
                <TextBlock Text="OpenDM · 自研分段引擎 · MIT License" Style="{StaticResource Muted}"
                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Opacity="0.6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
