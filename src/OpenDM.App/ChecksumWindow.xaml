<Window x:Class="OpenDM.App.ChecksumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SHA-256" Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,0,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="SHA-256 校验" FontSize="14.5" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="&#xE711;" Style="{StaticResource IconBtn}" Width="30" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <!-- 文件名 + 大小 -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <TextBlock x:Name="FileNameText" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,0"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="MetaText" Style="{StaticResource Muted}" FontSize="11"
                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
            </Grid>

            <!-- 哈希值：计算中就写「正在计算…」，完成后替换 -->
            <TextBox x:Name="HashBox" Grid.Row="2" Style="{StaticResource Input}" Height="44"
                     IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
                     Text="正在计算…" VerticalContentAlignment="Center"
                     HorizontalScrollBarVisibility="Hidden"/>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <ProgressBar x:Name="Bar" Style="{StaticResource SlimBar}" VerticalAlignment="Center"
                             Margin="0,0,86,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="HintText" Grid.Row="4" Style="{StaticResource Muted}" FontSize="11"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="可直接和官方公布的 SHA-256 校验值比对。"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CopyBtn" Content="复制哈希" Style="{StaticResource ToolBtn}"
                        Width="94" MinHeight="38" IsEnabled="False" Click="CopyHash_Click"/>
                <Button Content="关闭" Style="{StaticResource PrimaryBtn}" Width="92" MinHeight="38"
                        Margin="10,0,0,0" Click="Close_Click" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
