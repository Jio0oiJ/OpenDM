<Window x:Class="OpenDM.App.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenDM.App"
        Title="新建下载" Width="620" Height="584" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24,0,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="新建下载" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="&#xE711;" Style="{StaticResource IconBtn}" Width="30" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <!-- 地址 -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="下载地址" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UrlBox" Style="{StaticResource Input}"
                         TextChanged="UrlBox_TextChanged"/>
            </StackPanel>

            <!-- 保存位置 -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="保存到" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource Input}"/>
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource ToolBtn}"
                            Margin="8,0,0,0" MinHeight="40" Padding="12,0" Click="Browse_Click"/>
                </Grid>
            </StackPanel>

            <!-- 文件名 -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="文件名" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Input}"/>
            </StackPanel>

            <!-- 连接数 -->
            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <TextBlock Text="并发连接数（1–64）" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="ConnSlider" Width="260" Minimum="1" Maximum="64"
                            Value="8" IsSnapToTickEnabled="True" TickFrequency="1"
                            Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Value, ElementName=ConnSlider, StringFormat={}{0:F0}}"
                               FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="个连接" Style="{StaticResource Muted}" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                           Text="分段数受文件大小限制，小文件会自动减少分段；服务器限流时连接开太多反而更慢"/>
            </StackPanel>

            <!-- Cookie / 请求头 -->
            <StackPanel Grid.Row="5" Margin="0,16,0,0">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Cookie / 请求头（可选，访问需要登录的资源时填）"
                               Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="导入文件…" Style="{StaticResource LinkBtn}" Click="ImportHeaders_Click"/>
                        <Button Content="清空" Style="{StaticResource LinkBtn}" Margin="14,0,0,0"
                                Click="ClearHeaders_Click"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="HeaderBox" Style="{StaticResource Input}" Height="86"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                         TextChanged="HeaderBox_TextChanged"/>

                <TextBlock x:Name="HeaderHint" Style="{StaticResource Muted}" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="可直接粘贴 Cookie 串、浏览器里「Copy as cURL」的整条命令，或导出的 cookies.txt"/>
            </StackPanel>

            <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="{StaticResource RedBrush}"
                       FontSize="11.5" VerticalAlignment="Bottom" Visibility="Collapsed"
                       TextWrapping="Wrap"/>

            <!-- 按钮 -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="取消" Style="{StaticResource ToolBtn}" Width="88" MinHeight="40"
                        Click="Close_Click" IsCancel="True"/>
                <Button x:Name="OkBtn" Content="开始下载" Style="{StaticResource PrimaryBtn}" Width="112"
                        MinHeight="40" Margin="10,0,0,0" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
